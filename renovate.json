{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "docker:enableMajor", "helpers:pinGitHubActionDigests"],
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": false,
  "minimumReleaseAge": "3 days",
  "vulnerabilityAlerts": {
    "minimumReleaseAge": "0 days"
  },
  "packageRules": [
    {
      "matchCategories": ["docker"],
      "pinDigests": true
    },
    {
      "matchUpdateTypes": ["major"],
      "automerge": false
    },
    {
      "description": "A new Python minor needs wheels for every backend dependency (3.15 broke watchfiles). Move Python by hand after checking them.",
      "matchDepNames": ["python"],
      "matchUpdateTypes": ["major", "minor"],
      "enabled": false
    }
  ]
}
